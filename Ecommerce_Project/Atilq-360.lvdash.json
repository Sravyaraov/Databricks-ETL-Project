    {
      "name": "top_5_customers",
      "displayName": "Top 10 Customers by Revenue",
      "queryLines": [
        "SELECT\n",
        "  customer,\n",
        "  SUM(total_amount_inr) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  customer\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "fmcg",
      "schema": "gold"
    }
